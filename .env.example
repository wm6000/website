# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — sends the 6-digit email sign-in code. Get an API key at https://resend.com/api-keys
# Until a sending domain is verified in Resend, EMAIL_FROM can only deliver to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Website <onboarding@resend.dev>"
